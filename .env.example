# Copy to .env and fill in. Only the first block is required.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────

# The only key you need. https://openrouter.ai/keys — no credit card.
#
# On a fresh account you get 50 free-model requests per day. Buying $10 of
# credit once raises that to 1,000/day permanently — it is a lifetime unlock,
# not a balance requirement, so spending the credit later does not drop you
# back. Buying more than $10 does not raise it further.
OPENROUTER_API_KEY=sk-or-v1-...

# Login for the web dashboard. It is published on your network, so these are
# what stand between your agent and everyone else on it.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Signs session cookies. Any long random string; without it every restart logs
# you out.  Generate one:  openssl rand -hex 32
DASHBOARD_SECRET=

# ── Telegram (optional, but it is the point) ──────────────────────────

# Talk to your agent from your phone. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric ids, comma-separated. Run ./scripts/telegram-chat-id.sh to find yours.
#
# LEAVE THIS EMPTY AND ANYONE WHO FINDS YOUR BOT IS TALKING TO YOUR AGENT —
# with your files, your keys and your quota. Fill it in before exposing the bot.
TELEGRAM_ALLOWED_USERS=

# ── Host details ──────────────────────────────────────────────────────

# So files in ./data and ./files belong to you instead of root.
#   HERMES_UID=$(id -u) HERMES_GID=$(id -g) docker compose up -d
HERMES_UID=1000
HERMES_GID=1000

# Change if 9119 is taken — NAS boxes often have something there already.
DASHBOARD_PORT=9119

# Used for schedules and timestamps the agent shows you.
TZ=UTC
