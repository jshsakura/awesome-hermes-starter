# Copy to .env and fill in the first block. Nothing else is required.
#
#   cp .env.example .env
#
# Your OpenRouter key and Telegram token are NOT here. You add those in the
# setup screen at http://<your-server>:9120 once this is running — that is the
# point of this distribution.

# ── Required ──────────────────────────────────────────────────────────

# Login for both the setup screen (:9120) and the Hermes dashboard (:9119).
# They share one account on purpose: the setup screen can write your API key
# and your bot token, so it must not be the soft spot next to a locked door.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Signs session cookies for both. Any long random string; without a stable one
# every restart logs you out.  Generate one:  openssl rand -hex 32
DASHBOARD_SECRET=

# Turns on the gateway's OpenAI-compatible API, which is what the setup screen
# chats through. No port is published for it — only the other containers here
# can reach it.  Generate one:  openssl rand -hex 24
API_SERVER_KEY=

# ── Host details ──────────────────────────────────────────────────────

# So files in ./data and ./files belong to you instead of root.
#   HERMES_UID=$(id -u) HERMES_GID=$(id -g) docker compose up -d
HERMES_UID=1000
HERMES_GID=1000

# Change if these are taken — NAS boxes often have something there already.
DASHBOARD_PORT=9119
SETUP_PORT=9120

# Where the "open the Hermes dashboard" button goes at the end of setup.
# Use the address you actually reach this box on.
DASHBOARD_URL=http://localhost:9119

# Used for schedules and timestamps the agent shows you.
TZ=UTC
